# ────────────────────────────────────────────────────────────
# Indian Option MCP Server — Environment Configuration
# ────────────────────────────────────────────────────────────

# Data provider to use: "nse" (default, free) or "zerodha"
# DATA_PROVIDER=nse

# ── Zerodha Kite Connect (only needed if DATA_PROVIDER=zerodha) ──

# Your Kite Connect API key (from https://developers.kite.trade)
# KITE_API_KEY=your_api_key

# KITE_API_SECRET is intentionally NOT used by this server. Perform the Kite
# login / session exchange outside this process and pass only the access token.

# Access token (must be refreshed daily via login flow)
# KITE_ACCESS_TOKEN=your_access_token
